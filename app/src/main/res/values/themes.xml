<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose draws everything; the platform theme only supplies day/night system bars and no action bar. -->
    <style name="Theme.LyricsAdapter" parent="android:Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <!--
        The activity's theme in the manifest, so the system's launch window shows the logo on its colour,
        as the startup screen does once the app draws; MainActivity switches to the theme above.
    -->
    <style name="Theme.LyricsAdapter.Launch">
        <item name="android:windowBackground">@drawable/startup_window</item>
    </style>
</resources>
