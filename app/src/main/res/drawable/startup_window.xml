<?xml version="1.0" encoding="utf-8"?>
<!-- The launch window before Android 12, which has no splash screen of its own: the logo on its colour, where the startup screen then draws it. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <color android:color="@color/startup_background" />
    </item>
    <item
        android:width="288dp"
        android:height="288dp"
        android:drawable="@drawable/startup_icon"
        android:gravity="center" />
</layer-list>
